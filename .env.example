# ---------------------------------------------------------------------------
# Crew Connect API — environment template. Copy to `.env` and fill in.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# PostgreSQL (Prisma). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crew_connect?schema=public

# MongoDB (logs, notifications, SOS contacts)
MONGO_URI=mongodb://localhost:27017/crew_connect

# JWT — use long random strings in real environments (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=crew-connect-api

# OTP
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev-only: return the OTP in the API response (never enable in production)
OTP_DEV_EXPOSE=true
# Dev-only: accept any 4-digit code for crew login (ignored when NODE_ENV=production)
OTP_DEV_ACCEPT_ANY=true

# Encryption key for sensitive at-rest fields (Aadhaar, PAN, bank account).
# 32 bytes as hex or base64. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Google Sign-In (user app) — OAuth web client ID used to verify ID tokens
GOOGLE_CLIENT_ID=

# App API keys — comma-separated, one per client (user app, crew app, admin web).
# Clients send the key in every request as: X-API-Key: <key>
# Generate keys with: openssl rand -hex 32
# If left empty in dev the middleware warns but allows; in production all requests are rejected.
API_KEYS=dev-key-change-me

# CORS — comma-separated origins for the admin web app; use * to allow all (dev only)
CORS_ORIGINS=*

# Public origin used in uploaded file URLs (Android emulator: http://10.0.2.2:4000)
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=5242880

# Help & Support contacts shown in the user app
SUPPORT_EMAIL=support@crewconnect.com
SUPPORT_PHONE=+919515665550
SUPPORT_WHATSAPP=+919997775555

# Booking GST (fixed event rates live in crew_rate_cards, edited from the admin panel)
GST_PERCENT=18

# Admin seed (used by prisma/seed.js)
SEED_ADMIN_EMAIL=admin@crewconnect.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin
